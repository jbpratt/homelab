[Unit]
Description=Zigbee2MQTT coordinator
After=network-online.target
Wants=network-online.target

[Container]
Image=ghcr.io/koenkk/zigbee2mqtt:2.14.3@sha256:fb4a6b0f6868ad1cd6a9996479802b2420e599c3463b62bbff8c8cd9a908f43a
ContainerName=zigbee2mqtt
Pull=missing
AddDevice=/dev/serial/by-id/usb-Itead_Sonoff_Zigbee_3.0_USB_Dongle_Plus_V2_7c33458abaa1f011a59cd45165454926-if00-port0:/dev/ttyUSB0:rwm
GroupAdd=keep-groups
Volume=/home/jbpratt/.local/share/zigbee2mqtt:/app/data
Environment=TZ=America/Chicago
Environment=ZIGBEE2MQTT_CONFIG_MQTT_USER=zigbee
EnvironmentFile=/home/jbpratt/.config/zigbee2mqtt/mqtt.env
PublishPort=127.0.0.1:8080:8080

[Service]
Restart=on-failure
RestartSec=10
TimeoutStartSec=900

[Install]
WantedBy=default.target
